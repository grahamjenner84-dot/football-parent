{
  "crons": [
    {
      "path": "/api/cron/insights",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/insights-refresh",
      "schedule": "0 4 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/coach-app/:path*",
      "destination": "https://coach-app-zeta.vercel.app/:path*"
    }
  ]
}
